/* PyDracula-inspired dark theme: collapsible navigation, blue accents, soft cards. */
* { font-family: "Segoe UI"; font-size: 10pt; color: #f5f6f7; }
QMainWindow, QWidget#root { background: #1b1e23; }
QFrame#sidebar { background: #272c36; border: none; }
QFrame#topBar { background: #272c36; border-radius: 8px; }
QLabel#title { font-size: 16pt; font-weight: 600; color: #ffffff; }
QLabel#subtitle { color: #8a95aa; }
QGroupBox { background: #232831; border: 1px solid #343b48; border-radius: 8px; margin-top: 12px; padding: 12px 8px 8px 8px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #00c2ff; }
QPushButton { background: #343b48; border: none; border-radius: 6px; padding: 8px 12px; text-align: left; }
QPushButton:hover { background: #3c4454; }
QPushButton#primary { background: #00a6d6; color: white; font-weight: 600; text-align: center; }
QPushButton#primary:hover { background: #00b9ee; }
QLineEdit, QComboBox, QDoubleSpinBox, QListWidget { background: #1b1e23; border: 1px solid #343b48; border-radius: 5px; padding: 6px; selection-background-color: #00a6d6; }
QListWidget::item { padding: 5px; border-radius: 4px; }
QListWidget::item:selected { background: #00a6d6; }
QTableWidget {
    background: #1b1e23;
    alternate-background-color: #22262e;
    border: 1px solid #343b48;
    gridline-color: #343b48;
    selection-background-color: #00a6d6;
    selection-color: white;
}
QHeaderView::section {
    background: #272c36;
    color: #00c2ff;
    border: none;
    border-right: 1px solid #343b48;
    border-bottom: 1px solid #343b48;
    padding: 6px;
}
QTableCornerButton::section { background: #272c36; border: 1px solid #343b48; }QCheckBox { spacing: 7px; }
QTabWidget::pane { border: 1px solid #343b48; background: #1b1e23; }
QTabBar::tab { background: #272c36; padding: 9px 18px; margin-right: 2px; }
QTabBar::tab:selected { background: #00a6d6; }
QStatusBar { background: #272c36; color: #8a95aa; }
QScrollBar:vertical { background: #1b1e23; width: 10px; }
QScrollBar::handle:vertical { background: #4b5363; border-radius: 5px; min-height: 24px; }


QWidget#plotPanel, QScrollArea#plotScroll, QScrollArea#plotScroll QWidget#qt_scrollarea_viewport {
    background: #1b1e23;
    border: none;
}
QToolBar#plotToolbar {
    background: #272c36;
    border: none;
    border-bottom: 1px solid #343b48;
    spacing: 3px;
    padding: 3px;
}
QToolBar#plotToolbar QToolButton {
    background: #343b48;
    border-radius: 4px;
    padding: 4px 6px;
}
QToolBar#plotToolbar QToolButton:hover { background: #3c4454; }
QToolBar#plotToolbar QToolButton:checked { background: #00a6d6; }
QLabel#plotHint {
    background: #232831;
    color: #8a95aa;
    border: none;
    padding: 4px 8px;
    font-size: 8pt;
}
QSplitter::handle:horizontal {
    background: #343b48;
    width: 5px;
}
QSplitter::handle:horizontal:hover { background: #00a6d6; }
QSplitter::handle:vertical {
    background: #343b48;
    height: 5px;
}
QSplitter::handle:vertical:hover { background: #00a6d6; }
QScrollBar:horizontal { background: #1b1e23; height: 10px; }
QScrollBar::handle:horizontal { background: #4b5363; border-radius: 5px; min-width: 24px; }
